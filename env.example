# Copy to .env if desired. Do not commit your private .env.
BOOKBRIDGE_MODEL=gemma3:12b
BOOKBRIDGE_TEXT_MODEL=gemma3:1b
# cleanup (default), lookup (SearXNG + cleanup), off (primary scan only)
BOOKBRIDGE_ENRICHMENT=cleanup
# 0 unloads models after each pass. 5m keeps them loaded on larger machines.
BOOKBRIDGE_KEEP_ALIVE=0

# Existing Docker network shared by your Ollama/SearXNG services.
BOOKBRIDGE_NETWORK=revolt_default
